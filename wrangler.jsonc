  "d1_databases": [{ "binding": "DB", "database_name": "classroom-network-test-20261016", "database_id": "edc37799-82b4-426e-89a9-355a9c92caa4", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "2026101601", "simple": { "limit": 240, "period": 60 } }],
  "observability": { "enabled": false }
}
