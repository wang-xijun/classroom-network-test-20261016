{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-network-test-20261016",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
